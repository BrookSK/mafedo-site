# ============================================================================
# .htaccess de /public — usado quando o DocumentRoot aponta para esta pasta
# (configuração recomendada para produção).
# ============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Entrega arquivos/diretórios existentes diretamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tudo o mais vai para o front controller
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

Options -Indexes
AddDefaultCharset UTF-8

# Cabeçalhos de segurança (reforço ao que a aplicação já define)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Cache de assets estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Compressão
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Impedir execução de PHP na pasta de uploads
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php|phtml|php[0-9]|phar)$ - [F]
</IfModule>
